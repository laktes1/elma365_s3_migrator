# /etc/s3gw/s3gw.env, права 600, владелец s3gw. Общий для шлюза, обработчика и массового переноса.
JOURNAL_DB=/var/lib/s3gw/journal.db
BULK_DB=/var/lib/s3gw/bulk.db
# история переноса, строка раз в 30 с (~1 МБ в сутки); текущее состояние — BULK_STATUS_FILE, каждые 10 с
PROGRESS_FILE=/var/lib/s3gw/bulk-progress.jsonl
BULK_STATUS_FILE=/var/lib/s3gw/bulk-status.json

# Шлюз (на minio2; nginx на этой же машине шлёт сюда изменения s3elma365, после переключения (PIPELINE.md, C2) и чтения)
GW_LISTEN=127.0.0.1:9100
GW_UPSTREAM=http://127.0.0.1:9000
# другие бакеты (backups, loki, tempo) и запросы без бакета: всегда MinIO, без журнала, и после переключения тоже
GW_OTHER_UPSTREAM=http://127.0.0.1:9000
GW_BUCKET=s3elma365
GW_SETTLE_SECONDS=900
GW_ALLOW_BUCKET_OPS=
# пока файл существует, шлюз отвечает 503 на изменения, чтения идут (окно переключения, PIPELINE.md этап C)
GW_READONLY_FILE=/var/lib/s3gw/read-only
# Сколько ждать записи намерения в журнал, прежде чем ответить 503 SlowDown (с)
GW_JOURNAL_TIMEOUT=2
# Таймаут чтения ответа MinIO (с): CompleteMultipartUpload больших объектов идёт долго
GW_UPSTREAM_TIMEOUT=3600

# Источник: MinIO, отдельный пользователь только на чтение s3elma365
SRC_ENDPOINT=http://127.0.0.1:9000
SRC_ACCESS_KEY=YOUR_SRC_READONLY_KEY
SRC_SECRET_KEY=YOUR_SRC_READONLY_SECRET
SRC_BUCKET=s3elma365

# Приёмник: новое S3, отдельный пользователь на запись в один бакет
DST_ENDPOINT=https://NEW_S3_HOST:PORT
DST_ACCESS_KEY=YOUR_DST_KEY
DST_SECRET_KEY=YOUR_DST_SECRET
DST_BUCKET=s3elma365
S3_REGION=ru-central-1

# Обработчик изменений
HANDLER_WORKERS=4
# Аренда ключа в журнале (с), общая для обработчика и переноса: ключ упавшего процесса
# через это время берёт обработчик
GW_LEASE_SECONDS=900
# Попыток на ключ, затем state='error' (PIPELINE.md, «Ключи в error»); паузы 5, 10, 20 ... с, до 10 мин
HANDLER_MAX_ATTEMPTS=20

# Массовый перенос (docs/bulk-transfer-design.md, раздел 6)
BULK_WORKERS=8
LIST_WORKERS=4
LIST_PAGE_SIZE=1000
SCHEDULE_TZ=Europe/Moscow
SCHEDULE=08:00-20:00 workers=2 mbps=200; 20:00-08:00 workers=8 mbps=800
JOURNAL_BACKLOG_MAX=10000
# Попыток на задание и на диапазон листинга, затем 'error' ($B export-errors / retry-errors); паузы 2, 4, 8 ... с
BULK_MAX_ATTEMPTS=10
# Теги переносятся; GetObjectTagging идёт только к объектам с тегами (GET сообщает TagCount). 0 — не переносить
COPY_TAGS=1
